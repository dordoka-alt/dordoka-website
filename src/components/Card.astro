---
const { title, text } = Astro.props;
---

<div class="card">
    <h3>{title}</h3>
    <p>{text}</p>
</div>

<style>
    .card {
    background-color: #F6F6F0;
    padding: 2.5rem 2.5rem;
    border-radius: 1rem;
    height§: 100%;
    box-sizing: border-box;
    flex-direction: column;
    justify-content: space-between;
}

    .card h3 {
        font-size: 1.5rem;
        margin: 0 0 1rem 0;
        min-height: 3.5rem;
    }

    .card p {
        font-size: 1.1rem;
        line-height: 1.5;
        margin: 0;
    }
</style>