---
const { title, text, icon, highlight, href } = Astro.props;
---

    <div class="service-card">
        <div class="service-card-header">
            <span class="service-card-icon">
                {icon}
            </span>
            <h3>{title}</h3>
        </div>
        <div class="service-card-content">
            <p>{text}</p>
            {highlight && (
             <p class="highlight">{highlight}</p>
        )}
        </div>
        <div class="service-card-footer">
            <a href={href}>
            </a>
        </div>
    </div>

<style>

    .service-card {
        background-color: #F6F6F0;
        padding: 2.5rem 2.5rem;
        border-radius: 3rem;
        border: solid 1px #E0E0E0;
        height: 100%;
        max-width: 40rem;
        box-sizing: border-box;
        display: flex;
        flex-direction: column;
    

    }

    .service-card h3 {
        font-size: 1.5rem;
        margin: 0;
    }

    .service-card p {
        font-size: 1.1rem;
        line-height: 1.5;
        margin: 0;
    }

    .service-card-header {
        display: flex;
        align-items: center;
        gap: 1rem;
        margin-bottom: 2rem;
    }

    .service-card-footer {
        margin-top: 3rem;
        padding-top: 2rem;
    }

    .service-card-icon {
        font-size: 2rem;
    }

    .service-card-footer a {
        text-decoration: none;
        color: #000;
        font-weight: bold;
    }

    .service-card-footer a:hover {
        text-decoration: underline;
    }

    .highlight {
        font-weight: 700;
        margin-top: 2rem;
    }

    .service-card-content p + p {
    margin-top: 2rem;
    }      


</style>