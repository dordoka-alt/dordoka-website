---
const href = Astro.props.href;
---

<a href={href}>
    <slot />
</a>

<style>
    a{
    display:inline-block;
    text-decoration:none;
    padding: 1rem 2rem;
    border: 2px solid #00C3D0;
    border-radius: 1rem;
    background-color: #F6F6F0;
    transition: background-color 0.5s, color 0.2s;
    }

    a:hover{
        background-color: #00C3D0;
        color: #fff;
    }

 
</style>